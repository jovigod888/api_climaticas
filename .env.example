# Porta em que a API vai rodar
PORT=3000

# Tempo (em segundos) que o clima de cada país fica em cache antes de ser buscado de novo
CACHE_TTL_SECONDS=600

# Quantos países são consultados por requisição em lote à Open-Meteo
WEATHER_BATCH_SIZE=40

# Quantos lotes rodam em paralelo ao consultar todos os países
WEATHER_BATCH_CONCURRENCY=4
